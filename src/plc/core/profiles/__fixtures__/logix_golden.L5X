        <Description><![CDATA[Alarm light — module point Local:2:O.Pt01.Data]]></Description>
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
        </Data>
      </Tag>
      <Tag Name="DS3" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[DS3]]></Description>
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="0"/>
        </Data>
      </Tag>
      <Tag Name="ONS_2" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[ONS_2]]></Description>
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
        </Data>
      </Tag>
      <Tag Name="C3" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[C3]]></Description>
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
        </Data>
      </Tag>
      <Tag Name="Clock_1s_Tmr" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[CLOCK_TMR]]></Description>
        <Data Format="Decorated">
          <Structure DataType="TIMER">
            <DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
            <DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
            <DataValueMember Name="EN" DataType="BOOL" Value="0"/>
            <DataValueMember Name="TT" DataType="BOOL" Value="0"/>
            <DataValueMember Name="DN" DataType="BOOL" Value="0"/>
          </Structure>
        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
        <Tags/>
        <Routines>
        <Routine Name="MainRoutine" Type="RLL">
          <RLLContent>
            <Rung Number="0" Type="N">
              <Comment><![CDATA[1-second clock (CLICK SC7): ON 0.5 s, OFF 0.5 s]]></Comment>
              <Text><![CDATA[XIO(Clock_1s_Tmr.DN)TON(Clock_1s_Tmr,1000,0);]]></Text>
            </Rung>
            <Rung Number="1" Type="N">
              <Text><![CDATA[LES(Clock_1s_Tmr.ACC,500)OTE(Clock_1s);]]></Text>
            </Rung>
            <Rung Number="2" Type="N">
              <Text><![CDATA[JSR(Conveyor,0);]]></Text>
            </Rung>
            <Rung Number="3" Type="N">
              <Text><![CDATA[JSR(Alarms_counts,0);]]></Text>
            </Rung>
          </RLLContent>
        </Routine>
        <Routine Name="Conveyor" Type="RLL">
          <RLLContent>
            <Rung Number="0" Type="N">
              <Comment><![CDATA[Start / stop seal-in]]></Comment>
              <Text><![CDATA[[XIC(Start_PB)XIO(Stop_PB),XIC(Run_Latch)XIO(Stop_PB)]OTE(Run_Latch);]]></Text>
            </Rung>
            <Rung Number="1" Type="N">
              <Text><![CDATA[XIC(Run_Latch)XIO(Jam_Timer.DN)OTE(Conveyor_run);]]></Text>
            </Rung>
            <Rung Number="2" Type="N">
              <Comment><![CDATA[Jam_Timer preset from DS1 (sec → ms)]]></Comment>
              <Text><![CDATA[CPT(Jam_Timer.PRE,Jam_Time_SP*1000);]]></Text>
            </Rung>
            <Rung Number="3" Type="N">
              <Comment><![CDATA[Jam timer, setpoint in seconds from the HMI]]></Comment>
              <Text><![CDATA[XIC(Run_Latch)XIC(Part_sensor)TON(Jam_Timer,0,0);]]></Text>
            </Rung>
            <Rung Number="4" Type="N">
              <Comment><![CDATA[Run hours (retentive)]]></Comment>
              <Text><![CDATA[XIC(Conveyor_run)RTO(Run_Hours_Tmr,3600000,0);]]></Text>
            </Rung>
            <Rung Number="5" Type="N">
              <Comment><![CDATA[Reset Run_Hours_Tmr]]></Comment>
              <Text><![CDATA[XIC(Stop_PB)RES(Run_Hours_Tmr);]]></Text>
            </Rung>
          </RLLContent>
        </Routine>
        <Routine Name="Alarms_counts" Type="RLL">
          <RLLContent>
            <Rung Number="0" Type="N">
              <Comment><![CDATA[Part_Count preset from DS2]]></Comment>
              <Text><![CDATA[MOV(Batch_Target,Part_Count.PRE);]]></Text>
            </Rung>
            <Rung Number="1" Type="N">
              <Comment><![CDATA[Count parts]]></Comment>
              <Text><![CDATA[XIC(Part_sensor)ONS(ONS_1)CTU(Part_Count,0,0);]]></Text>
            </Rung>
            <Rung Number="2" Type="N">
              <Comment><![CDATA[Reset Part_Count]]></Comment>
              <Text><![CDATA[XIC(S:FS)RES(Part_Count);]]></Text>
            </Rung>
            <Rung Number="3" Type="N">
              <Text><![CDATA[GEQ(Tank_level,Level_High_SP)OTE(Level_High);]]></Text>
            </Rung>
            <Rung Number="4" Type="N">
              <Comment><![CDATA[Defaults on the first scan]]></Comment>
              <Text><![CDATA[XIC(S:FS)[MOV(10,Jam_Time_SP),MOV(90.0,Level_High_SP)];]]></Text>
            </Rung>
            <Rung Number="5" Type="N">
              <Comment><![CDATA[Alarm light flashes]]></Comment>
              <Text><![CDATA[[XIC(Level_High)XIC(Clock_1s),XIC(Jam_Timer.DN)]OTE(Alarm_light);]]></Text>
            </Rung>
            <Rung Number="6" Type="N">
              <Text><![CDATA[CPT(DS3,(Jam_Timer.ACC/1000) + Part_Count.ACC * 2);]]></Text>
            </Rung>
            <Rung Number="7" Type="N">
              <Comment><![CDATA[Reset count]]></Comment>
              <Text><![CDATA[XIO(Run_Latch)ONS(ONS_2)[RES(Part_Count),OTL(C3)];]]></Text>
            </Rung>
          </RLLContent>
        </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram"/>
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
