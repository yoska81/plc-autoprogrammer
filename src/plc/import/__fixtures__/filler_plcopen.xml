      <pou name="Level_Control" pouType="program">
        <interface>
          <localVars>
            <variable name="Level_Pct"><type><REAL /></type><documentation><xhtml:p>Bowl level, %</xhtml:p></documentation></variable>
            <variable name="Refill_Cnt"><type><derived name="CTU" /></type></variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[(* Bowl level from the 0-10 V sensor, 0..27648 counts *)
Level_Pct := INT_TO_REAL(Level_Raw) * 100.0 / 27648.0;
IF Level_Pct < 40.0 AND Running THEN
    Refill_Valve := TRUE;
ELSIF Level_Pct > 60.0 THEN
    Refill_Valve := FALSE;
END_IF;
Refill_Cnt(CU := Refill_Valve, RESET := FALSE, PV := 1000);
FOR i := 0 TO 3 DO
    Avg[i] := 0;
END_FOR;]]></xhtml:p>
          </ST>
        </body>
      </pou>
