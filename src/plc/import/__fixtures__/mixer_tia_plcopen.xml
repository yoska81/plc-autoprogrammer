      <pou name="FC_ScaleAnalog" pouType="function">
        <interface>
          <returnType><REAL /></returnType>
          <inputVars>
            <variable name="Raw"><type><INT /></type><documentation><xhtml:p>Raw analog word</xhtml:p></documentation></variable>
            <variable name="LoEng"><type><REAL /></type></variable>
            <variable name="HiEng"><type><REAL /></type></variable>
          </inputVars>
          <tempVars>
            <variable name="Norm"><type><REAL /></type></variable>
          </tempVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[// 4-20 mA input on SM 1231 AI, scaled to engineering units
IF #Raw < 0 THEN
    #FC_ScaleAnalog := #LoEng;
    RETURN;
END_IF;
#Norm := NORM_X(MIN := 0, VALUE := #Raw, MAX := 32767);
#FC_ScaleAnalog := SCALE_X(MIN := #LoEng, VALUE := #Norm, MAX := #HiEng);]]></xhtml:p>
          </ST>
        </body>
      </pou>
