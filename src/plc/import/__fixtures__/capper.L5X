<Tag Name="Stop_Gate" TagType="Alias" Radix="Decimal" AliasFor="Local:2:O.Data.1" ExternalAccess="Read/Write"/>
<Tag Name="Head_Down_SV" TagType="Alias" Radix="Decimal" AliasFor="Local:2:O.Data.2" ExternalAccess="Read/Write"/>
<Tag Name="Chuck_Motor" TagType="Alias" Radix="Decimal" AliasFor="Local:2:O.Data.3" ExternalAccess="Read/Write"/>
<Tag Name="Torque_Raw" TagType="Alias" Radix="Decimal" AliasFor="Local:3:I.Ch0Data" ExternalAccess="Read/Write"/>
