<Tag Name="EStop_OK" TagType="Alias" Radix="Decimal" AliasFor="Local:1:I.Data.2" ExternalAccess="Read/Write"/>
<Tag Name="Bottle_PE" TagType="Alias" Radix="Decimal" AliasFor="Local:1:I.Data.3" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bottle present under the capper]]>
</Description>
</Tag>
