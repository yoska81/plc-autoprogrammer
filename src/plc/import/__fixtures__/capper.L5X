<Description>
<![CDATA[Machine in automatic, running]]>
</Description>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="Fault_Latch" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="Reset_PB_HMI" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Fault reset from the PanelView]]>
</Description>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="Step" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Capping sequence step]]>
</Description>
<Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="Bottle_Count" TagType="Base" DataType="COUNTER" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bottles capped this shift]]>
</Description>
<Data Format="Decorated"><Structure DataType="COUNTER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="10000"/><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/></Structure></Data>
</Tag>
<Tag Name="Spin_Tmr" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="1500"/><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/></Structure></Data>
</Tag>
<Tag Name="Settle_Tmr" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="300"/><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/></Structure></Data>
</Tag>
<Tag Name="Head_Fault_Tmr" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="5000"/><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/></Structure></Data>
</Tag>
<Tag Name="Torque_Nm" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Chuck torque, N·m]]>
</Description>
<Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></Data>
</Tag>
<Tag Name="Torque_High" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="Capper" TagType="Base" DataType="Capper_UDT" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated"><Structure DataType="Capper_UDT"><DataValueMember Name="Running" DataType="BOOL" Value="0"/><DataValueMember Name="Torque_SP" DataType="REAL" Radix="Float" Value="2.5"/></Structure></Data>
</Tag>
<Tag Name="Start_ONS" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="Count_ONS" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
</Tags>
<Programs>
<Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Tags>
<Tag Name="Cycle_Count_Today" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/></Data>
</Tag>
</Tags>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(Modes,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Sequence,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(Alarms,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(Scaling,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Modes" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Machine run: start with all permissives, seal in, stop on stop PB, E-stop or fault]]>
</Comment>
<Text>
<![CDATA[[XIC(Start_PB)ONS(Start_ONS),XIC(Machine_Running)]XIC(Stop_PB)XIC(EStop_OK)XIC(Local:1:I.Data.7)XIO(Fault_Latch)OTE(Machine_Running);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Infeed conveyor runs while running, unless a bottle is being capped]]>
</Comment>
<Text>
<![CDATA[XIC(Machine_Running)[LES(Step,10),GRT(Step,40)]OTE(Conveyor_Run)OTE(Capper.Running);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Stack light red on any fault]]>
</Comment>
<Text>
<![CDATA[XIC(Fault_Latch)OTE(Local:2:O.Data.5);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Sequence" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Step 0 -> 10: bottle arrives, close the stop gate]]>
</Comment>
<Text>
<![CDATA[XIC(Machine_Running)EQU(Step,0)XIC(Bottle_PE)XIC(Head_Up_LS)MOV(10,Step);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Step 10: gate closed, let the bottle settle, then lower the head]]>
</Comment>
<Text>
<![CDATA[XIC(Machine_Running)EQU(Step,10)[OTE(Stop_Gate),TON(Settle_Tmr,300,0)];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Settle_Tmr.DN)EQU(Step,10)MOV(20,Step);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Steps 20-30: head down and chuck spinning]]>
</Comment>
<Text>
<![CDATA[XIC(Machine_Running)LIM(20,Step,30)[OTE(Head_Down_SV),OTE(Stop_Gate)];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[EQU(Step,20)XIC(Head_Down_LS)MOV(30,Step);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Step 30: spin the chuck for the spin time or until torque reached]]>
</Comment>
<Text>
<![CDATA[EQU(Step,30)[OTE(Chuck_Motor),TON(Spin_Tmr,1500,0)];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQU(Step,30)[XIC(Spin_Tmr.DN),GEQ(Torque_Nm,Capper.Torque_SP)]MOV(40,Step);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Step 40: head up, count the bottle, back to step 0]]>
</Comment>
<Text>
<![CDATA[EQU(Step,40)XIC(Head_Up_LS)XIO(Bottle_PE)[CLR(Step),ADD(Cycle_Count_Today,1,Cycle_Count_Today)];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[EQU(Step,40)XIC(Head_Up_LS)ONS(Count_ONS)CTU(Bottle_Count,10000,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Shift reset of the bottle count from the HMI]]>
</Comment>
<Text>
<![CDATA[XIC(Reset_PB_HMI)XIO(Machine_Running)RES(Bottle_Count);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Recipe message to the line PLC (kept as is)]]>
</Comment>
<Text>
<![CDATA[XIC(Machine_Running)MSG(Line_Msg);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Head did not reach a limit within 5 s]]>
</Comment>
<Text>
<![CDATA[[EQU(Step,20)XIO(Head_Down_LS),EQU(Step,40)XIO(Head_Up_LS)]TON(Head_Fault_Tmr,5000,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Head_Fault_Tmr.DN),XIC(Torque_High),XIO(Cap_Low_PX)XIC(Machine_Running)]OTL(Fault_Latch);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Reset faults from the HMI when the head is up]]>
</Comment>
<Text>
<![CDATA[XIC(Reset_PB_HMI)XIC(Head_Up_LS)[OTU(Fault_Latch),CLR(Step)];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Scaling" Type="ST">
<STContent>
<Line Number="0"><![CDATA[// 1769-IF4 0-31207 counts = 0-10 N·m]]></Line>
<Line Number="1"><![CDATA[Torque_Nm := Torque_Raw * 10.0 / 31207.0;]]></Line>
<Line Number="2"><![CDATA[IF Torque_Nm > 8.5 THEN]]></Line>
<Line Number="3"><![CDATA[    Torque_High := 1;]]></Line>
<Line Number="4"><![CDATA[ELSE]]></Line>
<Line Number="5"><![CDATA[    Torque_High := 0;]]></Line>
<Line Number="6"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
</Controller>
</RSLogix5000Content>
