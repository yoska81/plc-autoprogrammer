<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Studio 5000 bridge the installer ships: .NET Framework 4.8. It runs its job script (scripts/isa_logix_job.py,
       shipped next to the exe) with the Python of Rockwell's Logix Designer SDK. Shares the protocol, JSON and log with
       the TIA bridge.
       Its tests (tests/) run the same code on .NET 8 with a fake SDK. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Studio5000Bridge</AssemblyName>
    <RootNamespace>Studio5000Bridge</RootNamespace>
    <Version>0.1.0</Version>
    <Product>ISA Auto Programmer Studio 5000 bridge</Product>
    <Company>ISA</Company>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Compile Include="../tia-bridge/src/Json.cs;../tia-bridge/src/Protocol.cs;../tia-bridge/src/Log.cs" />
    <None Include="scripts/isa_logix_job.py" CopyToOutputDirectory="PreserveNewest" Link="isa_logix_job.py" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
