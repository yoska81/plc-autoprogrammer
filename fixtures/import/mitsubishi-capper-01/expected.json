      {
        "slot": 0,
        "name": "CPU",
        "catalog": "FX5U-32MT/ES",
        "description": "FX5U CPU, 16 DI (X0-X17) 24 V DC, 16 DO (Y0-Y17) transistor sink"
      }
    ],
    "programs": [
