  "knownIssues": [
    {
      "id": "MEL-1",
      "where": "MAIN, step 169 (OUT Y4 in 'Maintenance: jog spindle') and step 138 (OUT Y4 in 'Spindle')",
      "what": "Double coil: Y4 Spindle_Run is driven by two OUT instructions. The later maintenance jog rung (LDI M0 / AND X15 / OUT Y4) is evaluated last in the scan and overwrites the automatic result, so in AUTO (M0 ON) the spindle never runs, torque is never reached, every bottle times out as a reject and the machine stops on alarm M54 after 5 bottles.",
      "fix": "Drive Y4 from one rung only, e.g. replace the auto rung's OUT Y4 with OUT M70, the jog rung's OUT Y4 with OUT M71, and add: LD M70 / OR M71 / OUT Y4."
    }
  ]
