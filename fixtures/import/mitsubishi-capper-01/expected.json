  "sequence": {
    "style": "Step bits M100-M106 with SET/RST",
    "steps": [
      {
        "step": "M100",
        "description": "Wait for a bottle at the station (X4) for 0.5 s (T0); with a cap in the chuck (X5) and head up (X6) go to clamp."
      },
      {
        "step": "M101",
        "description": "Close the bottle clamp (Y2); when clamp closed (X10) go to capping. 2 s timeout T1 -> alarm M57."
      },
      {
        "step": "M102",
        "description": "Head down (Y3) and spindle on (Y4) until torque switch X11 -> dwell. No torque within 3 s of the head reaching down (X7, T2) -> mark reject (M60), count C1, go to head up."
      },
      {
        "step": "M103",
        "description": "Torque dwell 0.3 s (T3), head stays down, spindle off; then head up."
      },
      {
        "step": "M104",
        "description": "Head up (Y3 off); when head up (X6) go to unclamp. 3 s timeout T5 -> alarm M55."
      },
      {
        "step": "M105",
        "description": "Clamp opens (Y2 off); when clamp no longer closed, count good bottle in C0 (unless reject) and go to release."
      },
      {
        "step": "M106",
        "description": "Gate opens (Y1 off) for 1 s (T4), cap feed (Y5) until a cap is in the chuck, reject pusher (Y6) if M60; then clear M60 and back to step 1."
      }
    ],
    "batchEnd": "When C0 reaches D0 (500) and the sequence is back in step 1, M0 is reset (machine stops) and C0 is reset."
  },
