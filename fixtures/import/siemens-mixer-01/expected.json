  "format": "PLCopen TC6 XML 2.01 (FB in LD, FC in ST/SCL) + TIA Portal PLC tag table export (CSV of the .xlsx columns)",
  "machine": "Batch mixing tank MT01. On Start (tank idle, outlet valve closed, lid closed) the tank is filled with ingredient A (water) to 40 % and ingredient B (syrup) to 80 %, measured by a 4-20 mA level transmitter. The agitator then starts and an immersion heater brings the batch to 65 degC; the heater is interlocked with agitator running feedback, minimum level (20 %), the safety thermostat and the setpoint. After 5 minutes of mixing at temperature the outlet valve drains the tank; 10 s after the level is below 3 % the batch is done, counted, and waits for acknowledge. Analog scaling is done by an SCL function, the sequence and interlocks by a LAD function block with set/reset step bits; alarms latch until Reset.",
  "plc": {
    "brand": "Siemens",
    "family": "S7-1200",
    "cpu": "CPU 1214C DC/DC/DC",
    "cpuOrderNumber": "6ES7214-1AG40-0XB0",
    "firmware": "V4.6",
    "software": "TIA Portal V18",
    "modules": [
      {
        "slot": 1,
        "name": "PLC_1",
        "order": "6ES7214-1AG40-0XB0",
        "description": "CPU 1214C DC/DC/DC, 14 DI 24 V DC / 10 DQ 24 V DC / 2 AI 0-10 V (onboard AI unused)"
      },
      {
        "slot": 2,
        "name": "AI 4x13BIT_1",
        "order": "6ES7231-4HD32-0XB0",
        "description": "SM 1231 AI 4 x 13 bit, channels 0-1 set to current 4-20 mA, I address IW96..IW103"
      }
    ],
    "blocks": [
      {
        "name": "FB_Mixer",
        "type": "FB",
        "number": 1,
        "language": "LAD",
        "instanceDB": "Mixer_DB",
        "calledFrom": "OB1 Main"
      },
      {
        "name": "FC_ScaleAnalog",
        "type": "FC",
        "number": 10,
        "language": "SCL",
        "returns": "Real"
      }
    ]
  },
