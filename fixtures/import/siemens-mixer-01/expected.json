      "type": "TON",
      "presetMs": 600000,
      "preset": "T#10M",
      "purpose": "Fill A + Fill B watchdog",
      "where": "FB_Mixer, network 11"
    },
    {
      "name": "T_Mix",
      "type": "TON",
      "presetMs": 300000,
