  "sequence": {
    "style": "Set/reset step bits in FB_Mixer statics (S_Idle initial value TRUE)",
    "steps": [
      {
        "step": "S_Idle",
        "description": "Ready. Rising edge of Start_PB with Stop_PB healthy, no fault, outlet valve closed and lid closed starts the batch (Fill A).",
        "exitNetwork": 15
      },
      {
        "step": "S_FillA",
        "description": "Inlet valve A open until Level_Pct >= SP_Level_A (40 %).",
        "exitNetwork": 16
      },
      {
        "step": "S_FillB",
        "description": "Inlet valve B open until Level_Pct >= SP_Level_B (80 %).",
        "exitNetwork": 17
      },
      {
        "step": "S_Heat",
        "description": "Agitator runs, heater on until Temp_C >= SP_Temp (65 degC).",
        "exitNetwork": 18
      },
      {
        "step": "S_Mix",
        "description": "Agitator runs and heater holds temperature for Mix_Time (T#5M).",
        "exitNetwork": 19
      },
      {
        "step": "S_Drain",
        "description": "Outlet valve open; when Level_Pct <= SP_Drain_Empty (3 %) for 10 s go to Done.",
        "exitNetwork": 20
      },
      {
        "step": "S_Done",
        "description": "Batch counted (C_Batch), done lamp on; Reset_PB returns to Idle.",
        "exitNetwork": 22
      }
    ],
    "abort": "Stop_PB pressed or any alarm resets every step bit and sets S_Idle (tank is not drained automatically)."
  },
  "timers": [
    {
      "name": "T_AgitFB",
      "type": "TON",
      "presetMs": 3000,
      "preset": "T#3S",
