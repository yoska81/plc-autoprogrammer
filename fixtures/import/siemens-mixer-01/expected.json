      "condition": "FC_ScaleAnalog Fault output for Level_Raw",
      "stopsMachine": true,
      "latched": true,
      "reset": "Reset_PB",
      "where": "FB_Mixer, network 8"
    },
    {
      "address": "Mixer_DB.Alm_TempSensor",
      "tag": "Alm_TempSensor",
      "text": "Temperature transmitter fault",
      "condition": "FC_ScaleAnalog Fault output for Temp_Raw",
      "stopsMachine": true,
      "latched": true,
      "reset": "Reset_PB",
      "where": "FB_Mixer, network 9"
    },
    {
      "address": "Mixer_DB.Alm_AgitFeedback",
      "tag": "Alm_AgitFeedback",
      "text": "Agitator no running feedback",
      "condition": "Agitator_Run without Agitator_Running for 3 s",
      "stopsMachine": true,
      "latched": true,
      "reset": "Reset_PB",
      "where": "FB_Mixer, network 10"
    },
    {
      "address": "Mixer_DB.Alm_FillTimeout",
      "tag": "Alm_FillTimeout",
      "text": "Fill timeout",
      "condition": "S_FillA or S_FillB active for 10 min",
      "stopsMachine": true,
      "latched": true,
      "reset": "Reset_PB",
      "where": "FB_Mixer, network 11"
    }
  ],
  "interlocks": [
