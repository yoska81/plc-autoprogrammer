  "knownIssues": [
    {
      "id": "S7-1",
      "where": "FC_ScaleAnalog (SCL), NORM_X call",
      "code": "#Norm := NORM_X(MIN := 0, VALUE := #Raw, MAX := 32767);",
      "what": "Wrong full-scale value: the raw word is normalised with MAX := 32767, but the S7-1200 nominal range for a 4-20 mA channel is 0..27648. Every scaled value reads 15.6 % low (20 mA shows 84.4 % level / 126.6 degC). Level setpoint B (80 %) is only reached at a real level of about 94.8 %, so the tank overfills toward the high-high switch, and the heater runs to about 77 degC real for a 65 degC setpoint.",
      "fix": "#Norm := NORM_X(MIN := 0, VALUE := #Raw, MAX := 27648);"
    }
  ]
}
