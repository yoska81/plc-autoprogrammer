<Tag Name="Alm" TagType="Base" DataType="DINT" Dimensions="2" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Alarm word array (one bit per alarm, latched)]]>
</Description>
<Comments>
<Comment Operand="[0].0">
<![CDATA[Emergency stop pressed]]>
</Comment>
<Comment Operand="[0].1">
<![CDATA[Guard door open]]>
</Comment>
<Comment Operand="[0].2">
<![CDATA[Low air pressure]]>
</Comment>
<Comment Operand="[0].3">
<![CDATA[Infeed conveyor motor overload]]>
</Comment>
<Comment Operand="[0].4">
<![CDATA[Pusher failed to extend]]>
</Comment>
<Comment Operand="[0].5">
<![CDATA[Pusher failed to retract]]>
</Comment>
<Comment Operand="[0].6">
<![CDATA[Elevator overtravel (height > 1950 mm)]]>
</Comment>
<Comment Operand="[0].7">
<![CDATA[Case jam at infeed]]>
</Comment>
<Comment Operand="[0].8">
<![CDATA[Elevator failed to reach top]]>
</Comment>
</Comments>
<Data Format="L5K">
<![CDATA[[0,0]]]>
</Data>
<Data Format="Decorated">
<Array DataType="DINT" Dimensions="2" Radix="Decimal">
<Element Index="[0]" Value="0"/>
<Element Index="[1]" Value="0"/>
</Array>
</Data>
</Tag>
