<Data Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="20000"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[First scan: sequencer to idle]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)MOV(0,Seq_Step);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Safety_Modes,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(Infeed,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(LayerForm,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(Elevator,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[JSR(Alarms,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[JSR(HMI,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Safety_Modes" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Safety chain healthy: E-stop relay, guard door and air pressure]]>
</Comment>
<Text>
<![CDATA[XIC(E_Stop_OK)XIC(Guard_Door_Closed)XIC(Air_Pressure_OK)OTE(Safety_OK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Machine run: Start in AUTO with Stop not pressed, safety OK and no latched fault]]>
</Comment>
<Text>
<![CDATA[XIC(Start_PB)XIC(Stop_PB)XIC(Safety_OK)XIC(Auto_Sel)XIO(Fault_Latched)OTE(Machine_Running);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Any alarm latches a fault stop]]>
</Comment>
<Text>
<![CDATA[XIC(Alarm_Active)OTL(Fault_Latched);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Reset clears the fault stop once no alarm remains]]>
</Comment>
<Text>
<![CDATA[XIC(Reset_PB)XIO(Alarm_Active)OTU(Fault_Latched);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Infeed" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Infeed conveyor runs while the layer is accumulating (step 10)]]>
</Comment>
<Text>
<![CDATA[XIC(Machine_Running)EQU(Seq_Step,10)XIC(Infeed_OL_OK)OTE(Infeed_Conv_Run);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Layer table conveyor runs with the infeed during accumulation]]>
</Comment>
<Text>
<![CDATA[XIC(Machine_Running)EQU(Seq_Step,10)OTE(Layer_Conv_Run);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Cases per layer from HMI recipe]]>
</Comment>
<Text>
<![CDATA[MOV(Cases_Per_Layer,Case_Ctr.PRE);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Count cases entering the layer table]]>
</Comment>
<Text>
<![CDATA[XIC(Infeed_Count_PE)CTU(Case_Ctr,6,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Jam: case blocking the infeed eye for 5 s while the conveyor runs]]>
</Comment>
<Text>
<![CDATA[XIC(Infeed_Case_PE)XIC(Infeed_Conv_Run)TON(Infeed_Jam_Tmr,5000,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="LayerForm" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Machine stopped: sequencer back to idle]]>
</Comment>
<Text>
<![CDATA[XIO(Machine_Running)MOV(0,Seq_Step);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Step 0 -> 10: start conditions - elevator at top, pallet present, pusher retracted]]>
</Comment>
<Text>
<![CDATA[XIC(Machine_Running)EQU(Seq_Step,0)XIC(Elev_Up_LS)XIC(Pallet_Present_PE)XIC(Pusher_Retracted_PX)MOV(10,Seq_Step);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Step 10 -> 20: layer complete when case count reached]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,10)XIC(Case_Ctr.DN)MOV(20,Seq_Step);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Case stop blade up during push (steps 20 and 30)]]>
</Comment>
<Text>
<![CDATA[[EQU(Seq_Step,20),EQU(Seq_Step,30)]OTE(Case_Stop_Sol);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Pusher extend: only with case stop up and a pallet on the elevator]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,20)XIC(Case_Stop_Up_PX)XIC(Infeed_Case_PE)OTE(Pusher_Extend_Sol);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Step 20 watchdog]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,20)TON(Pusher_Ext_Tmr,3000,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Step 20 -> 30: pusher extended, layer is on the pallet]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,20)XIC(Pusher_Extended_PX)MOV(30,Seq_Step);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Step 30 watchdog]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,30)TON(Pusher_Ret_Tmr,3000,0);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Step 30 -> 40: pusher retracted, clear case count]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,30)XIC(Pusher_Retracted_PX)[RES(Case_Ctr),MOV(40,Seq_Step)];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Elevator" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Layers per pallet from HMI recipe]]>
</Comment>
<Text>
<![CDATA[MOV(Layers_Per_Pallet,Layer_Ctr.PRE);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Step 40: lower one layer pitch (timed)]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,40)TON(Layer_Lower_Tmr,1500,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Step 40 -> 50: count the layer]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,40)XIC(Layer_Lower_Tmr.DN)[CTU(Layer_Ctr,5,0),MOV(50,Seq_Step)];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Step 50 -> 10: pallet not full, form next layer]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,50)XIO(Layer_Ctr.DN)MOV(10,Seq_Step);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Step 50 -> 60: pallet full]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,50)XIC(Layer_Ctr.DN)MOV(60,Seq_Step);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Step 60 -> 70: elevator at bottom]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,60)XIC(Elev_Down_LS)MOV(70,Seq_Step);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Step 70: discharge full pallet]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,70)OTE(Pallet_Conv_Run);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Step 70: run-on after pallet leaves the eye]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,70)XIO(Pallet_Present_PE)TON(Discharge_Tmr,3000,0);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Step 70 -> 80]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,70)XIC(Discharge_Tmr.DN)MOV(80,Seq_Step);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Step 80 -> 90: operator has loaded an empty pallet]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,80)XIC(Pallet_Present_PE)MOV(90,Seq_Step);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Step 90 watchdog]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,90)TON(Elev_Raise_Tmr,20000,0);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Step 90 -> 10: elevator back at top, clear layer count]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,90)XIC(Elev_Up_LS)[RES(Layer_Ctr),MOV(10,Seq_Step)];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Hoist DOWN: steps 40 and 60, stop at bottom limit, not with UP]]>
</Comment>
<Text>
<![CDATA[[EQU(Seq_Step,40),EQU(Seq_Step,60)]XIO(Elev_Down_LS)XIO(Elev_Up_Mtr)OTE(Elev_Down_Mtr);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Hoist UP: step 90, stop at top limit, not with DOWN]]>
</Comment>
<Text>
<![CDATA[EQU(Seq_Step,90)XIO(Elev_Up_LS)XIO(Elev_Down_Mtr)OTE(Elev_Up_Mtr);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Alarm 0: E-stop]]>
</Comment>
<Text>
<![CDATA[XIO(E_Stop_OK)OTL(Alm[0].0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Alarm 1: guard door]]>
</Comment>
<Text>
<![CDATA[XIO(Guard_Door_Closed)OTL(Alm[0].1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Alarm 2: air pressure]]>
</Comment>
<Text>
<![CDATA[XIO(Air_Pressure_OK)OTL(Alm[0].2);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Alarm 3: infeed overload]]>
</Comment>
<Text>
<![CDATA[XIO(Infeed_OL_OK)OTL(Alm[0].3);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Alarm 4: pusher extend timeout]]>
</Comment>
<Text>
<![CDATA[XIC(Pusher_Ext_Tmr.DN)OTL(Alm[0].4);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Alarm 5: pusher retract timeout]]>
</Comment>
<Text>
<![CDATA[XIC(Pusher_Ret_Tmr.DN)OTL(Alm[0].5);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Alarm 6: elevator overtravel]]>
</Comment>
<Text>
<![CDATA[GRT(Elev_Position,1950.0)OTL(Alm[0].6);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Alarm 7: infeed jam]]>
</Comment>
<Text>
<![CDATA[XIC(Infeed_Jam_Tmr.DN)OTL(Alm[0].7);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Alarm 8: elevator raise timeout]]>
</Comment>
<Text>
<![CDATA[XIC(Elev_Raise_Tmr.DN)OTL(Alm[0].8);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Reset clears all alarm words (still-present conditions re-latch)]]>
</Comment>
<Text>
<![CDATA[XIC(Reset_PB)ONS(Reset_ONS)[MOV(0,Alm[0]),MOV(0,Alm[1])];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Summary]]>
</Comment>
<Text>
<![CDATA[[NEQ(Alm[0],0),NEQ(Alm[1],0)]OTE(Alarm_Active);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Green: running without alarm]]>
</Comment>
<Text>
<![CDATA[XIC(Machine_Running)XIO(Alarm_Active)OTE(Light_Green);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Amber: stopped without alarm]]>
</Comment>
<Text>
<![CDATA[XIO(Machine_Running)XIO(Alarm_Active)OTE(Light_Amber);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Red: any alarm]]>
</Comment>
<Text>
<![CDATA[XIC(Alarm_Active)OTE(Light_Red);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Silence horn from HMI]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Silence_PB)ONS(Silence_ONS)OTL(Horn_Silenced);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Re-arm horn when alarms clear]]>
</Comment>
<Text>
<![CDATA[XIO(Alarm_Active)OTU(Horn_Silenced);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Horn]]>
</Comment>
<Text>
<![CDATA[XIC(Alarm_Active)XIO(Horn_Silenced)OTE(Horn);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Count completed pallets]]>
</Comment>
<Text>
<![CDATA[XIC(Layer_Ctr.DN)CTU(Pallet_Count,32767,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Reset pallet total from HMI]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Reset_Count)RES(Pallet_Count);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[HMI values]]>
</Comment>
<Text>
<![CDATA[[MOV(Seq_Step,HMI_Step),MOV(Case_Ctr.ACC,HMI_Case_Count),MOV(Layer_Ctr.ACC,HMI_Layer_Count),MOV(Pallet_Count.ACC,HMI_Pallet_Count)];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
<CST MasterID="0"/>
<WallClockTime LocalTimeAdjustment="0" TimeZone="0"/>
<Trends/>
<DataLogs/>
<TimeSynchronize Priority1="128" Priority2="128" PTPEnable="false"/>
<EthernetPorts>
<EthernetPort Port="1" Label="1" PortEnabled="true"/>
</EthernetPorts>
</Controller>
</RSLogix5000Content>
